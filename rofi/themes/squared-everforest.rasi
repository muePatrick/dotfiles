configuration {
    modi:                       "window,drun";
    show-icons:                 true;
    display-drun:               "";
    // display-run:                "";
    // display-filebrowser:        "";
    display-window:             "";
    display-window:             "";
    drun-display-format:        "{name} [<span weight='light' size='small'><i>{generic}</i></span>]";
    window-format:              "<span weight='heavy' size='small'>{class}</span> <span weight='light' size='small'><i>󰅂 {title}</i></span>";
}

* {
    font:   "JetBrains Mono NL 12";

    bgt-1: #60728080;
    bg0:     #2B3339;
    bgt0:     #2B3339B0;
    bg1:     #323D43;
    bgt1:     #323D4380;
    fg0:     #D3C6AA;

    accent-color:     #A7C080;
    urgent-color:     #DBBC7F;

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0;
    padding:    0;
    spacing:    0;
}

window {
    location:   center;
    width:      800;
    padding: 16px;

    background-color:   @bgt0;
    border-radius: 15px;
}

// mainbox {
//     children:                    [ "inputbar", "listview", "mode-switcher" ];
// }

inputbar {
    spacing:    8px;
    padding:    8px;
    margin:    0 0 16px 0;

    background-color:   @bgt-1;
    border-radius: 5px;

    children: [ "textbox-prompt-colon", "entry" ];
}

prompt, entry, element-icon, element-text {
    vertical-align: 0.5;
}

prompt {
    text-color: @accent-color;
}

textbox-prompt-colon {
    margin: 4px 0 0 4px;
    enabled:                     true;
    expand:                      false;
    str:                         " ";
}

entry {
    placeholder: "Search...";
}

textbox {
    padding:            8px;
    background-color:   @bgt1;
}

listview {
    padding:    4px 0;
    lines:      8;
    columns:    1;

    fixed-height:   true;
}

element {
    padding:    8px;
    spacing:    8px;
    margin: 0 0 8px 0;
}

element normal normal {
    text-color: @fg0;
}

element normal urgent {
    text-color: @urgent-color;
}

element normal active {
    text-color: @accent-color;
}

element alternate active {
    text-color: @accent-color;
}

element selected {
    text-color: @bg0;
    border-radius: 5px;
}

element selected normal, element selected active {
    background-color:   @accent-color;
}

element selected urgent {
    background-color:   @urgent-color;
}

element-icon {
    size:   0.8em;
}

element-text {
    text-color: inherit;
}

mode-switcher{
    enabled:                     false;
    // spacing:                     10px;
    // margin:                      0px;
    // padding:                     0px;
    // border:                      0px solid;
    // border-radius:               0px;
    // border-color:                @border-colour;
    // background-color:            transparent;
    // text-color:                  @foreground-colour;
}
